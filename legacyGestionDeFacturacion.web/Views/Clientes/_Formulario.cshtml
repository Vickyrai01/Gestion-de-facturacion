@model legacyGestionDeFacturacion.web.Models.Cliente

@Html.ValidationSummary(false, "Revisá los datos ingresados.", new { @class = "text-danger", role = "alert" })
<div class="mb-3">
    @Html.LabelFor(model => model.Nombre, new { @class = "form-label" })
    @Html.TextBoxFor(model => model.Nombre, new { @class = "form-control", maxlength = "100", autocomplete = "given-name" })
    @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
</div>
<div class="mb-3">
    @Html.LabelFor(model => model.Apellido, new { @class = "form-label" })
    @Html.TextBoxFor(model => model.Apellido, new { @class = "form-control", maxlength = "100", autocomplete = "family-name" })
    @Html.ValidationMessageFor(model => model.Apellido, "", new { @class = "text-danger" })
</div>
<div class="mb-3">
    @Html.LabelFor(model => model.Documento, new { @class = "form-label" })
    @Html.TextBoxFor(model => model.Documento, new { @class = "form-control", maxlength = "30" })
    @Html.ValidationMessageFor(model => model.Documento, "", new { @class = "text-danger" })
</div>
<div class="mb-3">
    @Html.LabelFor(model => model.Email, new { @class = "form-label" })
    @Html.TextBoxFor(model => model.Email, new { @class = "form-control", type = "email", maxlength = "254", autocomplete = "email" })
    @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
</div>
