@{
    ViewBag.Title = "Inicio";
}

<section class="py-4" aria-labelledby="titulo-sistema">
    <h1 id="titulo-sistema">Sistema de Gestión de Facturación</h1>
    <p class="lead">Organizá la información de tus clientes como primer paso para gestionar la facturación de tu negocio.</p>
    <p>Registrá clientes, consultá sus datos, actualizá su información y desactivá los que ya no estén vigentes.</p>
    <p>@Html.ActionLink("Administrar clientes", "Index", "Clientes", null, new { @class = "btn btn-primary" })</p>
</section>
