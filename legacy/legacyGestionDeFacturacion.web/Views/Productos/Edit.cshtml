@model FacturacionLegacy.Datos.Entidades.Producto
@{ ViewBag.Title = "Editar producto"; }
<h1>Editar producto</h1>
<p>Estado actual: @(Model.Activo ? "Activo" : "Inactivo").</p>
@using (Html.BeginForm("Edit", "Productos", new { id = Model.Id }, FormMethod.Post, new { @class = "formulario-cliente" }))
{
    @Html.AntiForgeryToken()
    @Html.Partial("_Formulario", Model)
    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-outline-secondary" })
}
@section scripts { @Scripts.Render("~/bundles/jqueryval") }
