<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="Clientes.MensajeAlta" value="Cliente registrado correctamente." />
    <!-- Validadores clásicos, sin dependencia de jQuery. La validación de servidor sigue activa. -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <globalization culture="es-AR" uiCulture="es-AR" fileEncoding="utf-8" />
    <pages controlRenderingCompatibilityVersion="4.0" />
  </system.web>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Clientes.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
