@{
    ViewBag.Title = "Inicio";
}

<section class="py-4" aria-labelledby="titulo-sistema">
    <h1 id="titulo-sistema">Sistema de Gestión de Facturación</h1>
    <p class="lead">Administrá clientes y productos, creá facturas y consultá su estado.</p>
    <p>El sistema calcula los importes y conserva los precios históricos. Los impuestos son un ejemplo didáctico.</p>
    <p>@Html.ActionLink("Administrar clientes", "Index", "Clientes", null, new { @class = "btn btn-primary" })</p>
    <p>@Html.ActionLink("Ver productos", "Index", "Productos", null, new { @class = "btn btn-outline-primary" }) @Html.ActionLink("Ver facturas", "Index", "Facturas", null, new { @class = "btn btn-outline-primary" })</p>
</section>
