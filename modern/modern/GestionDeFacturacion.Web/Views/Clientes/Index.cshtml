@model List<GestionDeFacturacion.Web.Models.Cliente>
@{
    ViewData["Title"] = "Cliente";
}
@section Styles {<link rel="stylesheet" href="~/css/clientes.css" asp-append-version="true" />}

    <h2>Gestión de clientes</h2>
    <p class="page-description">Registrá un cliente y consultá el listado de clientes registrados.</p>
    <section class="panel" aria-labelledby="tituloRegistro">
        <h3 id="tituloRegistro">Registrar cliente</h3>
        <form asp-controller= "Clientes" asp-action="Crear" method="post">
        
            <div asp-validation-summary="ModelOnly" class="text-danger"/>
            <div class="form-fields">
            <p class="field">
                <Label Text="Nombre" />
                @Html.TextBox("Nombre", null, new {maxlength = 100, required = "required"})
                @Html.ValidationMessage("Nombre")
            </p>
            <p class="field">
                <label for="Email">Email</label>
                @Html.TextBox("Email", null, new { type = "email", maxlength = "254", required = "required" })
                @Html.ValidationMessage("Email")
            </p>
            </div>
            
            <button type="submit" class="button-primary">Guardar</button>
        </form>

        @if (TempData["Mensaje"] is string mensaje)
            {
                <p class="result" role="status">@mensaje</p>
            }

    </section>
    <section class="panel" aria-labelledby="tituloListado">
        <h3 id="tituloListado">Clientes registrados</h3>
        <div class="table-container">
                    @if (Model.Count == 0)
                    {
                        <p>Todavía no hay clientes.</p>
                    }
                    else
                    {
                        <table class="clients-table">
                            <thead>
                                <tr>
                                    <th scope="col">Id</th>
                                    <th scope="col">Nombre</th>
                                    <th scope="col">Email</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cliente in Model)
                                {
                                    <tr>
                                        <td>@cliente.Id</td>
                                        <td>@cliente.Nombre</td>
                                        <td>@cliente.Email</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
            </div>
        </section>
    </div>
    </section>
